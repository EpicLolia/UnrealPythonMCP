{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    "files.eol": "\n",
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.removeUnusedImports": "explicit",
      "source.fixAll.eslint": "explicit",
    },

    "editor.tabSize": 2,
    "cSpell.words": ["hasattr", "modelcontextprotocol", "toolsets"],
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "launch",
        "name": "Launch Workbench",
        "program": "${workspaceFolder}/dist/main_workbench.js",
        "args": ["--inspect"],
        "outFiles": ["${workspaceFolder}/dist/**/*.js"],
        "sourceMaps": true,
        "preLaunchTask": "tsc build"
      }
    ],
    "compounds": []
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "tsc build",
        "type": "shell",
        "command": "npx",
        "args": ["tsc", "-p", "tsconfig.json"],
        "group": {
          "kind": "build",
          "isDefault": true,
        },
        "problemMatcher": ["$tsc-watch"],
      },
      {
        "label": "npm publish",
        "type": "shell",
        "command": "npm",
        "args": ["publish"],
        "group": {
          "kind": "build",
        },
        "isBackground": true,
        "problemMatcher": ["$tsc-watch"],
        "dependsOn": ["tsc build"],
      },
    ],
  },
}
